source "https://rubygems.org"

# This Gemfile pins github-pages, which gives you the same Jekyll/plugin
# versions GitHub Pages uses to build your site. You only need this file
# if you want to preview the site locally — GitHub builds it for you when
# you push.
gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-include-cache"
end
